{
  "name": "biowell-compagnon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "epuriel:post": "start \"Test POST API Epuriel - version simple\" cmd /c \"\\\"%CD%\\\\scripts\\\\test-post-epuriel-simple.bat\\\"\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "1.54.1",
    "@vitejs/plugin-react": "4.3.3",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "26.6.6",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "typescript-eslint": "8.32.1",
    "vitest": "2.1.5"
  }
}
